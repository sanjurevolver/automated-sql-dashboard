// Create these measures individually on fact_transaction after importing the four tables.
Transaction Count = COUNTROWS(fact_transaction)
Active Accounts = DISTINCTCOUNT(fact_transaction[account_id])
Gross Volume CZK = SUM(fact_transaction[amount])
Inflow CZK = CALCULATE([Gross Volume CZK], fact_transaction[direction] = "credit")
Outflow CZK = CALCULATE([Gross Volume CZK], fact_transaction[direction] = "debit")
Net Flow CZK = SUM(fact_transaction[signed_amount])
Average Transaction CZK = DIVIDE([Gross Volume CZK], [Transaction Count])
Volume Per Active Account CZK = DIVIDE([Gross Volume CZK], [Active Accounts])
High Value Count = CALCULATE([Transaction Count], fact_transaction[high_value] = TRUE())
High Value Share = DIVIDE([High Value Count], [Transaction Count])
Previous Month Volume CZK = CALCULATE([Gross Volume CZK], DATEADD(dim_date[date_key], -1, MONTH))
Volume MoM % = DIVIDE([Gross Volume CZK] - [Previous Month Volume CZK], [Previous Month Volume CZK])
Rolling 90D Volume CZK = CALCULATE([Gross Volume CZK], DATESINPERIOD(dim_date[date_key], MAX(dim_date[date_key]), -90, DAY))
Negative Balance Events = CALCULATE([Transaction Count], fact_transaction[balance] < 0)
