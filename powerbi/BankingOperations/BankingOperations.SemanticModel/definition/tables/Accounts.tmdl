	partition Accounts = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ReportDirectory & "\dim_account.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"account_id", Int64.Type}, {"district_id", Int64.Type}, {"frequency", type text}, {"opened_date", type date}}, "en-US")
				in
				    Typed

