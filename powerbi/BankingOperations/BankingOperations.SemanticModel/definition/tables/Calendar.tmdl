	partition Calendar = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(ReportDirectory & "\dim_date.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"date_key", type date}, {"year", Int64.Type}, {"month", Int64.Type}, {"quarter", Int64.Type}, {"weekday", Int64.Type}}, "en-US")
				in
				    Typed

